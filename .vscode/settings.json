  "phpunit.command": "docker compose exec -t backend /bin/sh -c \"mkdir -p /home/oem/Projetos/clinic-saas && ln -sfn /var/www /home/oem/Projetos/clinic-saas/backend && cd /var/www && ${php} ${phpargs} ${phpunit} ${phpunitargs}\"",
